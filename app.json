{
  "expo": {
    "name": "Resto Grill",
    "slug": "restaurant-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-glow.png",
    "scheme": "restaurantapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/logo-glow.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101512",
        "foregroundImage": "./assets/images/logo-glow.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kellyangela.restaurantapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101512",
          "image": "./assets/images/logo-glow.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "247e2b2e-b701-4f5d-9f78-c0049a7c752c"
      }
    }
  }
}
